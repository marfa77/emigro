[Unit]
Description=Emigro Portugal Porto channel — one post to @emigro_portugal
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/emigro
PermissionsStartOnly=true
ExecStartPre=/bin/mkdir -p /opt/emigro/deploy/portugal-porto/logs /opt/emigro/deploy/portugal-porto/state
ExecStartPre=/bin/chown -R www-data:www-data /opt/emigro/deploy/portugal-porto
ExecStart=/bin/bash /opt/emigro/deploy/portugal-porto/run_scheduled.sh
User=www-data
EnvironmentFile=-/opt/emigro/.env
StandardOutput=append:/opt/emigro/deploy/portugal-porto/logs/scheduled.log
StandardError=append:/opt/emigro/deploy/portugal-porto/logs/scheduled.log

[Install]
WantedBy=multi-user.target
