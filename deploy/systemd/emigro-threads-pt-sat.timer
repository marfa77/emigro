[Unit]
Description=Emigro Threads Portugal satellite — daily post (Europe/Lisbon)

[Timer]
OnCalendar=Mon *-*-* 10:40:00 Europe/Lisbon
OnCalendar=Tue *-*-* 11:00:00 Europe/Lisbon
OnCalendar=Wed *-*-* 11:10:00 Europe/Lisbon
OnCalendar=Thu *-*-* 10:50:00 Europe/Lisbon
OnCalendar=Fri *-*-* 10:40:00 Europe/Lisbon
OnCalendar=Sat *-*-* 11:00:00 Europe/Lisbon
OnCalendar=Sun *-*-* 11:20:00 Europe/Lisbon
RandomizedDelaySec=25min
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
