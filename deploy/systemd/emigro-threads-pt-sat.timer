[Unit]
Description=Emigro Threads Portugal satellite — one post every 2 days, random daytime (Europe/Lisbon)

[Timer]
# Code keeps a 2-day gap. Clock is a new random minute between 08:20 and 19:20 Lisbon.
OnCalendar=*-*-* 08:20:00 Europe/Lisbon
RandomizedDelaySec=11h
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
