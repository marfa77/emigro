[Unit]
Description=Emigro Threads Italy satellite — one post every 2 days, random daytime (Europe/Rome)

[Timer]
# Code keeps a 2-day gap. Clock is a new random minute between 08:40 and 19:40 Rome.
OnCalendar=*-*-* 08:40:00 Europe/Rome
RandomizedDelaySec=11h
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
