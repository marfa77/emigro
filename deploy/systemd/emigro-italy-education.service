[Unit]
Description=Emigro Italy education channel — one parent post to @emigro_Italy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/emigro
PermissionsStartOnly=true
ExecStartPre=/bin/mkdir -p /opt/emigro/deploy/italy-education/logs /opt/emigro/deploy/italy-education/state
ExecStartPre=/bin/chown -R www-data:www-data /opt/emigro/deploy/italy-education
ExecStart=/bin/bash /opt/emigro/deploy/italy-education/run_scheduled.sh
User=www-data
EnvironmentFile=-/opt/emigro/.env
StandardOutput=append:/opt/emigro/deploy/italy-education/logs/scheduled.log
StandardError=append:/opt/emigro/deploy/italy-education/logs/scheduled.log

[Install]
WantedBy=multi-user.target
