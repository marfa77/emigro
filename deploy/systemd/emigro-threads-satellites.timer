[Unit]
Description=Emigro Threads satellites — every 2 days, after the daily window (Europe/Lisbon)

[Timer]
# Same @emigro_assist gap as the daily bank. Runs after that window closes so it
# does not take the root when the daily post is the one due. Off days exit 0.
OnCalendar=*-*-* 19:30:00 Europe/Lisbon
RandomizedDelaySec=30min
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
