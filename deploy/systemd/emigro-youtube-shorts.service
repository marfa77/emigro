[Unit]
Description=Emigro YouTube Shorts — daily evergreen tip for @Emigro_news
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/emigro
EnvironmentFile=-/opt/emigro/.env
Environment=EMIGRO_YOUTUBE_SHORTS_ENABLED=1
Environment=EMIGRO_YOUTUBE_SHORTS_OUTPUT_ROOT=/opt/emigro/data/youtube-shorts
Environment=EMIGRO_YOUTUBE_SHORTS_STATE_FILE=/opt/emigro/data/youtube-shorts/state.json
Environment=GSUTIL_HOME=/opt/emigro/data
Environment=CLOUDSDK_CONFIG=/opt/emigro/data/gcloud-config
Environment=GOOGLE_APPLICATION_CREDENTIALS=/opt/emigro/data/gcs-upload-key.json
# Remotion (headless Chrome) shares a 4 GB host with the Threads farm and content crons.
# Keep it polite: one render thread, low priority, hard memory ceiling. If the cgroup
# OOM-kills Chrome, generate.ts falls back to the ffmpeg engine for that day.
Environment=EMIGRO_YOUTUBE_SHORTS_ENGINE=remotion
Environment=EMIGRO_YOUTUBE_SHORTS_REMOTION_CONCURRENCY=1
Environment=HOME=/opt/emigro/data/youtube-shorts
Nice=10
IOSchedulingClass=idle
CPUQuota=150%
MemoryHigh=1800M
MemoryMax=2200M
TimeoutStartSec=50min
# "+" = run as root: www-data cannot chown, and data/ is owned by the rsync user.
ExecStartPre=+/bin/bash /opt/emigro/deploy/youtube-shorts/prepare_dirs.sh
ExecStart=/bin/bash /opt/emigro/deploy/youtube-shorts/run_daily.sh

[Install]
WantedBy=multi-user.target
