[Unit]
Description=Emigro Milan/Como soft-expert + abuse scan (Telethon → LLM draft → factcheck → DM)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/emigro
ExecStart=/bin/bash /opt/emigro/deploy/milan4at-scan/run_scheduled.sh
User=www-data
EnvironmentFile=-/opt/emigro/parser/.env
EnvironmentFile=-/opt/emigro/.env
StandardOutput=append:/opt/emigro/deploy/milan4at-scan/logs/scheduled.log
StandardError=append:/opt/emigro/deploy/milan4at-scan/logs/scheduled.log

[Install]
WantedBy=multi-user.target
