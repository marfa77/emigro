[Unit]
Description=Emigro Portugal satellite Threads publisher
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=8min
WorkingDirectory=/opt/emigro
# Journal first — append:/path fails with 209/STDOUT if the log dir is missing
# before ExecStartPre can mkdir (systemd opens stdout before ExecStartPre).
User=www-data
EnvironmentFile=-/opt/emigro/.env
StandardOutput=journal
StandardError=journal
ExecStart=/bin/bash /opt/emigro/deploy/threads-portugal-satellite/run_scheduled.sh

[Install]
WantedBy=multi-user.target
