[Unit]
Description=Emigro country news stories — Observador + The Local → RU tiles
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/emigro
PermissionsStartOnly=true
ExecStartPre=/bin/mkdir -p /opt/emigro/deploy/portugal-news-stories/logs
ExecStartPre=/bin/chown www-data:www-data /opt/emigro/deploy/portugal-news-stories/logs
ExecStart=/bin/bash /opt/emigro/deploy/portugal-news-stories/run_scheduled.sh
User=www-data
EnvironmentFile=-/opt/emigro/.env
StandardOutput=append:/opt/emigro/deploy/portugal-news-stories/logs/scheduled.log
StandardError=append:/opt/emigro/deploy/portugal-news-stories/logs/scheduled.log

[Install]
WantedBy=multi-user.target
