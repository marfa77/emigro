[Unit]
Description=Emigro Threads daily — one root every 2 days, random daytime (Europe/Lisbon)

[Timer]
# Code keeps a 2-day gap (gap_not_elapsed exits 0). The clock is a new random
# minute between 08:00 and 19:00 Lisbon. Daily and the shared satellite share that gap.
OnCalendar=*-*-* 08:00:00 Europe/Lisbon
RandomizedDelaySec=11h
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
