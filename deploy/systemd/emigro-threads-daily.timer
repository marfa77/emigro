[Unit]
Description=Emigro Threads daily — 1 post/day at same morning window as Barakhlo (Asia/Dubai)

[Timer]
# Match Barakhlo UAE morning peaks so the post sits in feed all day.
# +15–25 min offset avoids colliding with barakhlo-threads-post on the same VPS.
# Content calendar day still uses Europe/Lisbon in code (same date in this window).
OnCalendar=Mon *-*-* 12:20:00 Asia/Dubai
OnCalendar=Tue *-*-* 10:20:00 Asia/Dubai
OnCalendar=Wed *-*-* 12:20:00 Asia/Dubai
OnCalendar=Thu *-*-* 09:20:00 Asia/Dubai
OnCalendar=Fri *-*-* 10:20:00 Asia/Dubai
OnCalendar=Sat *-*-* 10:20:00 Asia/Dubai
OnCalendar=Sun *-*-* 11:20:00 Asia/Dubai
RandomizedDelaySec=25min
AccuracySec=1min
# Catch a missed morning window (same-day skip in pipeline prevents double-post).
Persistent=true

[Install]
WantedBy=timers.target
