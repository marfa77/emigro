[Unit]
Description=Emigro Thailand community daily at 06:00 UTC

[Timer]
# Shares TG_SESSION_STRING with barakhlo-parser (00/08/16 UTC, runs up to ~1h).
# Overlapping runs on different Telethon layers break both: keep outside those windows.
OnCalendar=*-*-* 06:00:00 UTC
Persistent=true
AccuracySec=5min

[Install]
WantedBy=timers.target
