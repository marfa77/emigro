[Unit]
Description=Emigro Invest Threads — one post every 2 days, random daytime (Asia/Dubai)

[Timer]
# Code keeps a 2-day gap from the last real post and takes the next unpublished row.
# Missed earlier dates stay missed. Clock is a new random minute, 08:30–19:30 Dubai.
OnCalendar=*-*-* 08:30:00 Asia/Dubai
RandomizedDelaySec=11h
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
