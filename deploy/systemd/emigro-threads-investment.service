[Unit]
Description=Emigro Invest Threads — isolated dated publisher (@emigro_invest)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=8min
WorkingDirectory=/opt/emigro
PermissionsStartOnly=true
ExecStartPre=/bin/mkdir -p /opt/emigro/deploy/threads-investment/logs /opt/emigro/parser/out
ExecStartPre=/bin/chown -R www-data:www-data /opt/emigro/deploy/threads-investment /opt/emigro/parser/out
ExecStart=/bin/bash /opt/emigro/deploy/threads-investment/run_scheduled.sh
User=www-data
EnvironmentFile=-/opt/emigro/.env
StandardOutput=append:/opt/emigro/deploy/threads-investment/logs/scheduled.log
StandardError=append:/opt/emigro/deploy/threads-investment/logs/scheduled.log

[Install]
WantedBy=multi-user.target
